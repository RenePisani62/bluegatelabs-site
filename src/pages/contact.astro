
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <h1>Contact</h1>

  <p>
    Have a question about BlueGate Labs, our software projects,
    or cybersecurity research? We'd be pleased to hear from you.
  </p>

  <section>
    <h2>General Enquiries</h2>
    <p>
      For general correspondence, project enquiries and collaboration:
      <a href="mailto:contact@bluegatelabs.au">
        contact@bluegatelabs.au
      </a>
    </p>
  </section>

  <section>
    <h2>Product Support</h2>
    <p>
      For questions or assistance with BlueGate Labs software:
      <a href="mailto:support@bluegatelabs.au">
        support@bluegatelabs.au
      </a>
    </p>
  </section>

  <section>
    <h2>Security</h2>
    <p>
      To report a security vulnerability or concern:
      <a href="mailto:security@bluegatelabs.au">
        security@bluegatelabs.au
      </a>
    </p>
  </section>

  <section>
    <h2>Privacy</h2>
    <p>
      For questions about privacy and personal information:
      <a href="mailto:privacy@bluegatelabs.au">
        privacy@bluegatelabs.au
      </a>
    </p>
  </section>
</Layout>
